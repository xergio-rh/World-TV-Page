<!-- FOOTER LIMPIO Y ELEGANTE -->
<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-col">
      <a href="{{ routes.root_url }}" class="footer-logo-link">
        <img src="{{ 'logo.png' | asset_url }}" alt="World TV" class="footer-logo" width="451" height="256">
      </a>

      <div class="footer-contact-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        <a href="mailto:{{ settings.contact_email | default: 'worldtvcolombia@gmail.com' }}" style="color:inherit; text-decoration:none;">{{ settings.contact_email | default: 'worldtvcolombia@gmail.com' }}</a>
      </div>

      <div class="footer-contact-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        <a href="tel:+573500010" style="color:inherit; text-decoration:none;">{{ settings.contact_phone | default: '(57) 3500010' }}</a>
      </div>

      <div class="footer-contact-item">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
        {{ settings.contact_location | default: 'Medellín, Antioquia, Colombia' }}
      </div>
    </div>

    <div class="footer-col">
      <h4>{{ section.settings.info_heading | default: 'Información' }}</h4>
      <ul>
        <li><a href="#envios" onclick="WTVCart.openInfoModal('shipping'); return false;">Términos y condiciones de envío</a></li>
        <li><a href="#devoluciones" onclick="WTVCart.openInfoModal('returns'); return false;">Devoluciones y retracto</a></li>
        <li><a href="#calidad" onclick="WTVCart.openInfoModal('quality'); return false;">Calidad de nuestros productos</a></li>
        <li><a href="#privacidad" onclick="WTVCart.openInfoModal('privacy'); return false;">Política de Tratamiento de Datos</a></li>
        <li><a href="#contacto" onclick="WTVCart.openInfoModal('contact'); return false;">Contáctenos</a></li>
      </ul>
    </div>

    <div class="footer-col footer-newsletter">
      <h4>{{ section.settings.newsletter_heading | default: 'Suscríbete a nuestro correo' }}</h4>
      <p style="font-size:12px; color:var(--text-muted); margin-bottom:12px;">
        {{ section.settings.newsletter_subtext | default: 'Descubre antes que nadie nuestras nuevas colecciones y promociones exclusivas.' }}
      </p>
      <form class="newsletter-form" onsubmit="return WTVCart.submitNewsletter(event, this);">
        <input type="email" name="email" placeholder="Correo electrónico" required>
        <button type="submit" class="btn-primary" style="display:block; width:100%; border:none; cursor:pointer; text-align:center; padding:10px;">SUSCRIBIRME</button>
      </form>
    </div>
  </div>

  <div class="footer-bottom">
    <div>© {{ 'now' | date: '%Y' }}, {{ shop.name | default: 'WorldTv Colombia' }} • Tecnología de Shopify</div>
    <div class="footer-payments">
      <svg class="inline-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
      Pagos Seguros | PSE | Tarjetas | Pago Contraentrega
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "info_heading",
      "label": "Título columna información",
      "default": "Información"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Título boletín",
      "default": "Suscríbete a nuestro correo"
    },
    {
      "type": "textarea",
      "id": "newsletter_subtext",
      "label": "Descripción boletín",
      "default": "Descubre antes que nadie nuestras nuevas colecciones y promociones exclusivas."
    }
  ]
}
{% endschema %}

