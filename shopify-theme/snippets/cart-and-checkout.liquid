<!-- MODAL DE CHECKOUT DUAL: PAGO CONTRAENTREGA (SOLO DATOS) O PAGAR AHORA (TARJETA / PSE / NEQUI) -->
<div class="checkout-modal-overlay" id="checkoutModalOverlay" onclick="toggleCheckoutModal()"></div>
<div class="checkout-modal-container" id="checkoutModal">
  <div class="checkout-modal-header">
    <h2 id="chkModalHeaderTitle"><svg class="inline-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;"><path d="M5 18H3c-.6 0-1-.4-1-1V9c0-.6.4-1 1-1h2m14 10h2c.6 0 1-.4 1-1v-4c0-.5-.2-1-.5-1.4l-3-4c-.3-.4-.8-.6-1.3-.6H15v6m-10 4h10m-10 0a2 2 0 1 0 4 0m6 0a2 2 0 1 0 4 0M7 8h8v6H7V8z"></path></svg> FINALIZAR PEDIDO — ELIGE CÓMO PAGAR</h2>
    <button class="checkout-close-btn" onclick="toggleCheckoutModal()">✕</button>
  </div>

  <!-- VISTA 1: FORMULARIO DE DATOS Y SELECTOR DE MÉTODO DE PAGO -->
  <div class="checkout-modal-body" id="codFormBodyView">
    <div class="checkout-form-col">
      <!-- SELECTOR DE LAS DOS OPCIONES DE PAGO -->
      <div class="payment-mode-selector" id="paymentModeSelector">
        <button type="button" class="pay-mode-tab active" id="tabPayCod" onclick="WTVCart.setPaymentMode('cod')">
          <div class="pay-mode-radio"></div>
          <div class="pay-mode-info">
            <strong>Pago Contraentrega</strong>
            <span>Solo tus datos • Pagas al recibir en casa</span>
          </div>
        </button>
        <button type="button" class="pay-mode-tab" id="tabPayOnline" onclick="WTVCart.setPaymentMode('online')">
          <div class="pay-mode-radio"></div>
          <div class="pay-mode-info">
            <strong>Pagar Ahora al Instante</strong>
            <span>Tarjeta Crédito/Débito, PSE, Nequi</span>
          </div>
        </button>
      </div>

      <div class="cod-form-notice" id="codFormNoticeBox">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#15803D" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        <div>
          <strong id="codNoticeTitle">PAGO CONTRAENTREGA: SOLO TUS DATOS DE ENVÍO</strong>
          <span id="codNoticeDesc">No necesitas tarjeta. Te despachamos hoy mismo y pagas en efectivo o transferencia al recibir en tu puerta.</span>
        </div>
      </div>

      <h3>1. DATOS PARA EL ENVÍO</h3>
