              <input type="text" id="chkFirstName" name="first_name" placeholder="Tu nombre" required>
            </div>
          </div>
          <div class="form-group">
            <label>Apellido *</label>
            <div class="input-with-icon">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
              <input type="text" id="chkLastName" name="last_name" placeholder="Tu apellido" required>
            </div>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Teléfono / WhatsApp *</label>
            <div class="input-with-icon">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <input type="tel" id="chkPhone" name="phone" placeholder="Ej: 300 123 4567" required>
            </div>
          </div>
          <div class="form-group">
            <label>Departamento *</label>
            <select id="chkProvince" name="province" required>
              <option value="" disabled selected>Selecciona Departamento</option>
              <option value="Antioquia">Antioquia</option>
              <option value="Bogotá D.C.">Bogotá D.C.</option>
              <option value="Cundinamarca">Cundinamarca</option>
              <option value="Valle del Cauca">Valle del Cauca</option>
              <option value="Atlántico">Atlántico</option>
              <option value="Santander">Santander</option>
              <option value="Bolívar">Bolívar</option>
              <option value="Risaralda">Risaralda</option>
              <option value="Caldas">Caldas</option>
              <option value="Quindío">Quindío</option>
              <option value="Tolima">Tolima</option>
              <option value="Huila">Huila</option>
              <option value="Meta">Meta</option>
              <option value="Nariño">Nariño</option>
              <option value="Cauca">Cauca</option>
              <option value="Norte de Santander">Norte de Santander</option>
              <option value="Magdalena">Magdalena</option>
              <option value="Cesar">Cesar</option>
              <option value="Córdoba">Córdoba</option>
              <option value="Boyacá">Boyacá</option>
              <option value="Casanare">Casanare</option>
              <option value="Sucre">Sucre</option>
              <option value="La Guajira">La Guajira</option>
              <option value="Caquetá">Caquetá</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Ciudad / Municipio *</label>
            <div class="input-with-icon">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <input type="text" id="chkCity" name="city" placeholder="Ej: Medellín, Bogotá, Cali..." required>
            </div>
          </div>
          <div class="form-group">
            <label>Dirección exacta *</label>
            <div class="input-with-icon">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <input type="text" id="chkAddress1" name="address1" placeholder="Calle / Carrera, Número y Barrio" required>
            </div>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Complemento (Casa / Apto / Punto de referencia):</label>
            <div class="input-with-icon">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
              <input type="text" id="chkAddress2" name="address2" placeholder="Ej: Apto 302, Conjunto Los Pinos">
            </div>
          </div>
          <div class="form-group">
            <label>Correo electrónico (Opcional):</label>
            <div class="input-with-icon">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <input type="email" id="chkEmail" name="email" placeholder="Opcional para guía de rastreo">
            </div>
          </div>
        </div>

        <!-- SECCIÓN DE PAGO EN LÍNEA AL INSTANTE (SOLO VISIBLE CUANDO SE ELIGE "PAGAR AHORA") -->
        <div id="onlinePaymentMethodsBox" class="online-payment-box" style="display: none;">
          <h3 style="margin-top: 14px; margin-bottom: 10px;">2. ELIGE TU MÉTODO DE PAGO AL INSTANTE</h3>
          <div class="online-methods-pills">
            <button type="button" class="online-method-pill active" id="pillMethodCard" onclick="WTVCart.selectOnlineSubMethod('card')">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
              Tarjeta Crédito / Débito
            </button>
            <button type="button" class="online-method-pill" id="pillMethodPse" onclick="WTVCart.selectOnlineSubMethod('pse')">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path><path d="M9 21V9"></path></svg>
              PSE / Nequi / Daviplata
            </button>
          </div>

          <!-- CAMPOS DE TARJETA DE CRÉDITO / DÉBITO -->
          <div id="onlineCardFields" class="online-sub-panel">
            <div class="form-group" style="margin-bottom: 10px;">
              <label>Número de Tarjeta (Visa, Mastercard, Amex) *</label>
              <div class="input-with-icon">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                <input type="text" id="chkCardNumber" placeholder="0000 0000 0000 0000" maxlength="19" autocomplete="cc-number">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>Vencimiento (MM/AA) *</label>
                <input type="text" id="chkCardExp" placeholder="MM/AA" maxlength="5" autocomplete="cc-exp" style="padding: 9px 11px; border: 1px solid #ddd; border-radius: 6px; font-size: 12px; width: 100%;">
              </div>
              <div class="form-group">
                <label>CVV / CVC *</label>
                <input type="password" id="chkCardCvv" placeholder="123" maxlength="4" autocomplete="cc-csc" style="padding: 9px 11px; border: 1px solid #ddd; border-radius: 6px; font-size: 12px; width: 100%;">
              </div>
              <div class="form-group">
                <label>Cuotas</label>
                <select id="chkCardInstallments" style="padding: 9px 11px; border: 1px solid #ddd; border-radius: 6px; font-size: 12px; width: 100%;">
                  <option value="1">1 cuota (Débito / Crédito)</option>
                  <option value="2">2 cuotas</option>
                  <option value="3">3 cuotas</option>
                  <option value="6">6 cuotas</option>
                  <option value="12">12 cuotas</option>
                </select>
              </div>
            </div>
          </div>

          <!-- CAMPOS DE PSE / NEQUI / DAVIPLATA / BANCOLOMBIA -->
          <div id="onlinePseFields" class="online-sub-panel" style="display: none;">
            <div class="form-row">
              <div class="form-group">
                <label>Selecciona tu Entidad o Billetera *</label>
                <select id="chkBankEntity" style="padding: 9px 11px; border: 1px solid #ddd; border-radius: 6px; font-size: 12px; width: 100%;">
                  <option value="Nequi">Nequi (Pago inmediato)</option>
                  <option value="Bancolombia">Bancolombia / Botón Bancolombia</option>
                  <option value="Daviplata">Daviplata</option>
                  <option value="Davivienda">PSE - Banco Davivienda</option>
                  <option value="Banco de Bogotá">PSE - Banco de Bogotá</option>
                  <option value="BBVA Colombia">PSE - BBVA Colombia</option>
                  <option value="Nu Colombia">PSE - Nu Colombia</option>
                  <option value="Scotiabank Colpatria">PSE - Scotiabank Colpatria</option>
                </select>
              </div>
              <div class="form-group">
                <label>Cédula / NIT del Titular *</label>
                <input type="text" id="chkPseDoc" placeholder="Número de documento" style="padding: 9px 11px; border: 1px solid #ddd; border-radius: 6px; font-size: 12px; width: 100%;">
              </div>
            </div>
          </div>
        </div>
      </form>
      <div class="shipping-banner-bar" id="chkBottomShippingBar">
        <svg class="inline-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg> DESPACHO INMEDIATO 24-48H | ENVÍO ASEGURADO A TODA COLOMBIA
      </div>
    </div>

    <div class="checkout-summary-col">
      <!-- RESUMEN DINÁMICO DE LOS PRODUCTOS EN EL PEDIDO -->
      <div id="chkItemsSummaryList" style="max-height: 165px; overflow-y: auto; margin-bottom: 12px; padding-right: 4px;"></div>

      <div class="checkout-receipt-box">
        <div class="receipt-row">
          <span>Subtotal</span>
          <strong id="chkSubtotal">$0</strong>
        </div>
