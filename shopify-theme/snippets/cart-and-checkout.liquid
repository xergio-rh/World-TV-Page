        <div class="checkout-pkgs-grid" id="chkPackagesGrid"></div>
      </div>

      <button class="btn-checkout-submit" id="chkMainSubmitBtn" type="button" onclick="WTVCart.submitCheckoutForm(event)">
        CONFIRMAR PEDIDO CONTRAENTREGA
      </button>
      <div class="payment-methods-icons" id="chkFooterGuaranteeText">
        <span><svg class="inline-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Pagas al recibir o en línea con total seguridad</span>
      </div>
    </div>
