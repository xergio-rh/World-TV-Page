<!-- TRUST BADGES + BANNER PROMOCIONAL PAGO CONTRAENTREGA -->
<section class="trust-section">
  <div class="trust-card">
    <div class="trust-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M5 18H3c-.6 0-1-.4-1-1V9c0-.6.4-1 1-1h2m14 10h2c.6 0 1-.4 1-1v-4c0-.5-.2-1-.5-1.4l-3-4c-.3-.4-.8-.6-1.3-.6H15v6m-10 4h10m-10 0a2 2 0 1 0 4 0m6 0a2 2 0 1 0 4 0M7 8h8v6H7V8z"></path></svg>
    </div>
    <div class="trust-text">
      <h4>Envíos a Toda Colombia</h4>
      <p>Despachos rápidos y asegurados en 24-48h</p>
    </div>
  </div>
  <div class="trust-card" style="border-color: rgba(158, 42, 43, 0.35);">
    <div class="trust-icon" style="color: var(--brand-red);">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
    </div>
    <div class="trust-text">
      <h4 style="color: var(--brand-red);">Pago 100% Contraentrega</h4>
      <p>Solo dejas tus datos y pagas al recibir</p>
    </div>
  </div>
  <div class="trust-card">
    <div class="trust-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
    </div>
    <div class="trust-text">
      <h4>Registro INVIMA</h4>
      <p>Garantía oficial y respaldo sanitario</p>
    </div>
  </div>
  <div class="trust-card">
    <div class="trust-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 22C6.5 22 2 17.5 2 12S6.5 2 12 2s10 4.5 10 10-4.5 10-10 10z"></path><path d="M12 6v6l4 2"></path></svg>
    </div>
    <div class="trust-text">
      <h4>100% Naturales</h4>
      <p>Ingredientes seleccionados para tu bienestar</p>
    </div>
  </div>
</section>

<!-- FRANJA PAGO CONTRAENTREGA -->
<section class="cod-band">
  <div class="cod-band-inner">
    <div class="cod-band-copy">
      <p class="cod-band-eyebrow">Pago contraentrega</p>
      <h3>Pide hoy y paga cuando recibas tu pedido</h3>
      <p>No pagas nada por adelantado. Nos dejas tus datos de envío y le pagas al transportador al recibir.</p>
    </div>
    <ol class="cod-band-steps">
      <li>
        <span class="cod-band-num">01</span>
        <strong>Elige tu producto</strong>
        <p>Selecciona la fórmula o el kit que deseas.</p>
      </li>
      <li>
        <span class="cod-band-num">02</span>
        <strong>Déjanos tus datos</strong>
        <p>Nombre, teléfono, ciudad y dirección.</p>
      </li>
      <li>
        <span class="cod-band-num">03</span>
        <strong>Paga al recibir</strong>
        <p>Entrega en 24 a 48 horas, pagas en casa.</p>
      </li>
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Sellos de Confianza",
  "presets": [
    {
      "name": "Sellos de Confianza"
    }
  ]
}
{% endschema %}
