<!-- 7. KITS Y COMBOS AHORRO (INTERACTIVOS Y CON PAGO CONTRAENTREGA DIRECTO) -->
<section class="kits-section-wrapper">
  <div class="section-header">
    <span class="cod-section-badge">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18H3c-.6 0-1-.4-1-1V9c0-.6.4-1 1-1h2m14 10h2c.6 0 1-.4 1-1v-4c0-.5-.2-1-.5-1.4l-3-4c-.3-.4-.8-.6-1.3-.6H15v6m-10 4h10m-10 0a2 2 0 1 0 4 0m6 0a2 2 0 1 0 4 0M7 8h8v6H7V8z"></path></svg>
      PÍDELOS CON PAGO CONTRAENTREGA — PAGAS EN CASA
    </span>
    <h2>{{ section.settings.title | default: 'ARMA TU TRATAMIENTO Y AHORRA' }}</h2>
    <p>{{ section.settings.subtitle | default: 'Elige tu kit favorito: combínalos y pídelos hoy mismo solo con tus datos de envío.' }}</p>
  </div>
  <div class="kits-grid">
    <!-- KIT 1: VITALIDAD DIARIA -->
    <div class="kit-card" id="kitCard1" onclick="WTVCart.highlightKitCard('kitCard1')" style="cursor: pointer; position: relative;">
      <div class="kit-image-box">
        <img src="{{ 'colasteel_melena.jpeg' | asset_url }}" alt="Kit Vitalidad Diaria" width="2528" height="1696">
      </div>
      <div class="kit-info">
        <span class="pill-badge">
          <svg class="inline-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
          Ahorra $35.000 • Contraentrega Gratis
        </span>
        <h3>{{ section.settings.kit_1_title | default: 'Kit Vitalidad Diaria' }}</h3>
        <p>{{ section.settings.kit_1_desc | default: '1x Melena de León SI100 + 1x Colasteel Cloruro de Magnesio para un soporte físico y mental completo.' }}</p>
        <div class="kit-price"><del>$179.800</del> $144.800</div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button type="button" class="btn-primary btn-pay-now-main" style="border: none; cursor: pointer; flex: 1; padding: 12px 12px; font-size: 11px;"
                  onclick="event.stopPropagation(); WTVCart.selectAndAddKit('kitCard1', {
                    id: 'kit-vitalidad-diaria',
                    variantId: 46764428198062,
                    extraVariantId: 46782984323246,
                    title: 'Kit Vitalidad Diaria (Melena + Colasteel)',
                    packTitle: 'Combo Ahorro 2 Productos',
                    price: 144800,
                    oldPrice: 179800,
                    image: '{{ 'colasteel_melena.jpeg' | asset_url }}'
                  }, true, 'online')">
            PAGAR AHORA
          </button>
          <button type="button" class="btn-primary btn-cod-main" style="border: none; cursor: pointer; flex: 1; padding: 12px 12px; font-size: 11px;"
                  onclick="event.stopPropagation(); WTVCart.selectAndAddKit('kitCard1', {
                    id: 'kit-vitalidad-diaria',
                    variantId: 46764428198062,
                    extraVariantId: 46782984323246,
                    title: 'Kit Vitalidad Diaria (Melena + Colasteel)',
                    packTitle: 'Combo Ahorro 2 Productos',
                    price: 144800,
                    oldPrice: 179800,
                    image: '{{ 'colasteel_melena.jpeg' | asset_url }}'
                  }, true, 'cod')">
            CONTRAENTREGA
          </button>
          <button type="button" class="btn-secondary" style="cursor: pointer; padding: 12px 14px;"
                  onclick="event.stopPropagation(); WTVCart.selectAndAddKit('kitCard1', {
                    id: 'kit-vitalidad-diaria',
                    variantId: 46764428198062,
                    extraVariantId: 46782984323246,
                    title: 'Kit Vitalidad Diaria (Melena + Colasteel)',
                    packTitle: 'Combo Ahorro 2 Productos',
                    price: 144800,
                    oldPrice: 179800,
                    image: '{{ 'colasteel_melena.jpeg' | asset_url }}'
                  }, false)">
            + Carrito
          </button>
        </div>
      </div>
    </div>

    <!-- KIT 2: DESCANSO & CLARIDAD -->
    <div class="kit-card" id="kitCard2" onclick="WTVCart.highlightKitCard('kitCard2')" style="cursor: pointer; position: relative;">
      <div class="kit-image-box">
        <img src="{{ 'inositol_clasicas.jpeg' | asset_url }}" alt="Kit Descanso y Claridad" width="2528" height="1696">
      </div>
      <div class="kit-info">
        <span class="pill-badge">
          <svg class="inline-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
          Pack Enfoque Total • Envío Gratis
        </span>
        <h3>{{ section.settings.kit_2_title | default: 'Kit Descanso & Claridad' }}</h3>
        <p>{{ section.settings.kit_2_desc | default: '1x Inositol en Polvo + 1x Gafas Relax Vision Clásicas para cuidar tu mente y tus ojos.' }}</p>
        <div class="kit-price"><del>$264.800</del> $219.800</div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <button type="button" class="btn-primary btn-pay-now-main" style="border: none; cursor: pointer; flex: 1; padding: 12px 12px; font-size: 11px;"
                  onclick="event.stopPropagation(); WTVCart.selectAndAddKit('kitCard2', {
                    id: 'kit-descanso-claridad',
                    variantId: 47972060758190,
                    extraVariantId: 46410573086894,
                    title: 'Kit Descanso & Claridad (Inositol + Gafas Clásicas)',
                    packTitle: 'Pack Visión y Mente',
                    price: 219800,
                    oldPrice: 264800,
                    image: '{{ 'inositol_clasicas.jpeg' | asset_url }}'
                  }, true, 'online')">
            PAGAR AHORA
          </button>
          <button type="button" class="btn-primary btn-cod-main" style="border: none; cursor: pointer; flex: 1; padding: 12px 12px; font-size: 11px;"
                  onclick="event.stopPropagation(); WTVCart.selectAndAddKit('kitCard2', {
                    id: 'kit-descanso-claridad',
                    variantId: 47972060758190,
                    extraVariantId: 46410573086894,
                    title: 'Kit Descanso & Claridad (Inositol + Gafas Clásicas)',
                    packTitle: 'Pack Visión y Mente',
                    price: 219800,
                    oldPrice: 264800,
                    image: '{{ 'inositol_clasicas.jpeg' | asset_url }}'
                  }, true, 'cod')">
            CONTRAENTREGA
          </button>
          <button type="button" class="btn-secondary" style="cursor: pointer; padding: 12px 14px;"
                  onclick="event.stopPropagation(); WTVCart.selectAndAddKit('kitCard2', {
                    id: 'kit-descanso-claridad',
                    variantId: 47972060758190,
                    extraVariantId: 46410573086894,
                    title: 'Kit Descanso & Claridad (Inositol + Gafas Clásicas)',
                    packTitle: 'Pack Visión y Mente',
                    price: 219800,
                    oldPrice: 264800,
                    image: '{{ 'inositol_clasicas.jpeg' | asset_url }}'
                  }, false)">
            + Carrito
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kits y Combos Ahorro",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "ARMA TU TRATAMIENTO Y AHORRA"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Combina nuestras mejores fórmulas y asegura tu bienestar al mejor precio."
    },
    {
      "type": "text",
      "id": "kit_1_title",
      "label": "Título Kit 1",
      "default": "Kit Vitalidad Diaria"
    },
    {
      "type": "textarea",
      "id": "kit_1_desc",
      "label": "Descripción Kit 1",
      "default": "1x Melena de León SI100 + 1x Colasteel Cloruro de Magnesio para un soporte físico y mental completo."
    },
    {
      "type": "url",
      "id": "kit_1_link",
      "label": "Enlace Kit 1"
    },
    {
      "type": "text",
      "id": "kit_2_title",
      "label": "Título Kit 2",
      "default": "Kit Descanso & Claridad"
    },
    {
      "type": "textarea",
      "id": "kit_2_desc",
      "label": "Descripción Kit 2",
      "default": "1x Inositol en Polvo + 1x Gafas Relax Vision Clásicas para cuidar tu mente y tus ojos."
    },
    {
      "type": "url",
      "id": "kit_2_link",
      "label": "Enlace Kit 2"
    }
  ],
  "presets": [
    {
      "name": "Kits y Combos Ahorro"
    }
  ]
}
{% endschema %}
