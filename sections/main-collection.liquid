{% assign col_handle = collection.handle | downcase %}

<!-- BANNER HERO DINÁMICO SEGÚN LA COLECCIÓN DE SHOPIFY -->
{% if col_handle contains 'lentes' or col_handle contains 'vision' %}
  <section class="vision-hero-banner" style="background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('{{ 'realx_vision_premuim_uso_hombre.webp' | asset_url }}');">
    <div class="vision-hero-content">
      <h1>PROTEGE TU MIRADA Y REDUCE LA <span>FATIGA OCULAR</span></h1>
    </div>
  </section>
{% elsif col_handle contains 'belleza' or col_handle contains 'cuidado' %}
  <section class="beauty-hero-banner" style="--beauty-bg-pc: url('{{ 'banner_belleza_pc.png' | asset_url }}'); --beauty-bg-mob: url('{{ 'banner_belleza_mobile.png' | asset_url }}');">
    <div class="beauty-hero-content">
      <h1>BELLEZA Y BIENESTAR PARA TU <span>PIEL Y CUERPO</span></h1>
    </div>
  </section>
{% elsif col_handle contains 'outlet' or col_handle contains 'fajas' or col_handle contains 'termicas' %}
  <section class="outlet-hero-banner" style="--outlet-bg-pc: url('{{ 'banner_outlet_hero_pc.png' | asset_url }}'); --outlet-bg-mob: url('{{ 'banner_outlet_hero_mobile.png' | asset_url }}');">
    <div class="outlet-hero-content">
      <h1>OUTLET PRENDAS <span>MOLDEADORAS Y TÉRMICAS</span></h1>
    </div>
  </section>
{% else %}
  <section class="nutricion-hero-banner" style="--nutricion-bg-pc: url('{{ 'banner_nutricion.jpeg' | asset_url }}'); --nutricion-bg-mob: url('{{ 'banner_nutricion_mobile.jpg' | asset_url }}');">
    <div class="nutricion-hero-content">
      <h1>REVOLUCIONA TU SALUD CON NUESTRA <span>LÍNEA DE NUTRICIÓN</span></h1>
    </div>
  </section>
{% endif %}

<!-- BARRA DE FILTROS -->
<section class="catalog-filters-bar">
  <div class="filters-container">
    <div class="filter-group">
      <span>Filtrar por:</span>
      <select class="filter-select" onchange="WTVCart.sortCollectionGrid(this);">
        <option value="manual">Más relevantes</option>
        <option value="price-ascending">Precio: Menor a Mayor</option>
        <option value="price-descending">Precio: Mayor a Menor</option>
      </select>
    </div>
    <div class="catalog-counter">
      <strong>{{ collection.products_count }}</strong> productos encontrados
    </div>
  </div>
</section>

<!-- GRID DE PRODUCTOS REALES DE LA COLECCIÓN EN SHOPIFY -->
<section class="bestsellers-section" style="margin-top: 20px;">
  <div class="products-grid {% if collection.products_count == 2 %}beauty-products-grid{% endif %}">
    {% for product in collection.products %}
      {% assign first_var = product.selected_or_first_available_variant %}
      {% assign v_raw = first_var.price | divided_by: 100 %}
      {% assign v_old_raw = first_var.compare_at_price | default: 0 | divided_by: 100 %}
      {% if product.handle contains 'cannabi' or product.handle contains 'canabi' %}
        {% assign prod_price_cop = 77231 %}
        {% assign prod_old_cop = 85000 %}
      {% elsif product.handle contains 'serum' %}
        {% assign prod_price_cop = 118405 %}
        {% assign prod_old_cop = 130000 %}
      {% elsif product.handle contains 'cloruro' or product.handle contains 'colasteel' or product.handle contains 'colageno' or product.handle contains 'citrato' %}
        {% assign prod_price_cop = 101031 %}
        {% assign prod_old_cop = 127500 %}
      {% elsif first_var.taxable %}
        {% assign prod_price_cop = v_raw | times: 119 | divided_by: 100 %}
        {% assign prod_old_cop = v_old_raw | times: 119 | divided_by: 100 %}
      {% else %}
        {% assign prod_price_cop = v_raw %}
        {% assign prod_old_cop = v_old_raw %}
      {% endif %}
      <article class="product-card beauty-card" onclick="window.location.href='{{ product.url }}'" style="cursor: pointer;">
        <div class="product-img-box">

          {% assign t_img = '' %}
          {% if product.handle contains 'cannabi' or product.handle contains 'canabi' %}
            {% assign t_img = 'cannabix_x_1-removebg-preview.png' | asset_url %}
          {% elsif product.handle contains 'serum' %}
            {% assign t_img = 'suerox2.webp' | asset_url %}
          {% elsif product.handle contains 'cloruro' or product.handle contains 'colasteel' %}
            {% assign t_img = 'cloruro_x_1_IA_4a08858f-a74e-4d46-a666-cbb3b61e67df-removebg-preview.png' | asset_url %}
          {% elsif product.handle contains 'melena' %}
            {% assign t_img = 'melena_x_1_IA-removebg-preview.png' | asset_url %}
          {% elsif product.handle contains 'resveratrol' %}
            {% assign t_img = 'ersveratrol2_df1e54aa-1b8c-4c39-b3df-a0e8d42ff75e-removebg-preview.png' | asset_url %}
          {% elsif product.handle contains 'inositol' %}
            {% assign t_img = 'inositol_x_1_IA-removebg-preview.png' | asset_url %}
          {% elsif product.handle contains 'amalaki' or product.handle contains 'gamaki' %}
            {% assign t_img = 'amalaki_x_1-removebg-preview.png' | asset_url %}
          {% elsif product.handle contains 'colageno' %}
            {% assign t_img = 'colageno_marino_x_1_IA-removebg-preview.png' | asset_url %}
          {% elsif product.handle contains 'citrato' %}
            {% assign t_img = 'citrato_x_1_IA-removebg-preview.png' | asset_url %}
          {% endif %}
          {% if t_img != blank %}
            <img src="{{ t_img }}" alt="{{ product.title | escape }}" width="600" height="600" loading="lazy" decoding="async">
          {% elsif product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600" loading="lazy" decoding="async">
          {% else %}
            <img src="{{ 'cloruro_x_1_IA_4a08858f-a74e-4d46-a666-cbb3b61e67df-removebg-preview.png' | asset_url }}" alt="{{ product.title | escape }}" width="1856" height="2304" loading="lazy" decoding="async">
          {% endif %}
        </div>
        <h3 class="product-title">{{ product.title }}</h3>
        {% if product.type != blank %}
          <p class="product-subtitle">{{ product.type }}</p>
        {% endif %}
        <div class="product-bottom beauty-bottom">
          <div class="price-box">
            {% if prod_old_cop > prod_price_cop %}
              <span class="old-p">{{ prod_old_cop | times: 100 | money }}</span>
            {% endif %}
            <span class="new-p" style="color:var(--brand-dark);">
              {{ prod_price_cop | times: 100 | money }}
            </span>
            <span class="tax-tag" style="font-size:10px; font-weight:700; color:#15803D; background:#DCFCE7; padding:2px 6px; border-radius:10px; display:inline-block; margin-top:2px;">IVA INCLUIDO</span>
          </div>
          <button type="button" class="btn-beauty-add"
                  onclick="event.stopPropagation(); WTVCart.addItem({
                    id: '{{ product.handle }}-{{ first_var.id }}',
                    variantId: {{ first_var.id }},
                    title: {{ product.title | json | escape }},
                    packTitle: {{ first_var.title | json | escape }},
                    price: {{ prod_price_cop }},
                    oldPrice: {{ prod_old_cop | default: 0 }},
                    image: '{% if t_img != blank %}{{ t_img }}{% elsif product.featured_image %}{{ product.featured_image | image_url: width: 300 }}{% else %}{{ 'cloruro_x_1_IA_4a08858f-a74e-4d46-a666-cbb3b61e67df-removebg-preview.png' | asset_url }}{% endif %}'
                  }, true);">
            AÑADIR +
          </button>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Colección Principal",
  "settings": []
}
{% endschema %}
