{% assign col_handle = collection.handle | downcase %}

<!-- BANNER HERO DINÁMICO SEGÚN LA COLECCIÓN DE SHOPIFY -->
{% if col_handle contains 'lentes' or col_handle contains 'vision' %}
  <section class="vision-hero-banner" style="background-image: linear-gradient(180deg, rgba(10, 14, 26, 0.62) 0%, rgba(10, 14, 26, 0.78) 100%), url('{{ 'realx_vision_premuim_uso_hombre.webp' | asset_url }}');">
    <div class="vision-hero-content">
      <span class="vision-tag-top"><svg class="inline-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="15" r="4"></circle><circle cx="18" cy="15" r="4"></circle><path d="M14 15a2 2 0 0 0-4 0"></path><path d="M2.5 13 5 7c.7-1.3 1.4-2 3-2"></path><path d="M21.5 13 19 7c-.7-1.3-1.5-2-3-2"></path></svg> TECNOLOGÍA ANTIRREFLEJO</span>
      <h1>PROTEGE TU MIRADA Y REDUCE LA <span>FATIGA OCULAR</span></h1>
      <p>Lentes especializados con filtro de luz azul y protección UV400 diseñados para cuidar tus ojos frente a pantallas y computadores.</p>
    </div>
  </section>
{% elsif col_handle contains 'belleza' or col_handle contains 'cuidado' %}
  <section class="beauty-hero-banner" style="background-image: linear-gradient(180deg, rgba(10, 14, 26, 0.62) 0%, rgba(10, 14, 26, 0.78) 100%), url('{{ 'Gemini_Generated_Image_tfwqcztfwqcztfwq.jpeg' | asset_url }}');">
    <div class="beauty-hero-content">
      <span class="beauty-tag-top"><svg class="inline-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path></svg> SKINCARE & AUTOCUIDADO</span>
      <h1>BELLEZA Y BIENESTAR PARA TU <span>PIEL Y CUERPO</span></h1>
      <p>Productos pensados para cuidar tu piel, tu cuerpo y tu bienestar diario. Fórmulas seleccionadas para acompañarte en tu rutina.</p>
    </div>
  </section>
{% elsif col_handle contains 'outlet' or col_handle contains 'fajas' or col_handle contains 'termicas' %}
  <section class="outlet-hero-banner" style="background-image: linear-gradient(180deg, rgba(10, 14, 26, 0.62) 0%, rgba(10, 14, 26, 0.78) 100%), url('{{ 'banneroutlet.jpeg' | asset_url }}');">
    <div class="outlet-hero-content">
      <span class="outlet-tag-top"><svg class="inline-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg> LIQUIDACIÓN TOTAL</span>
      <h1>OUTLET PRENDAS <span>MOLDEADORAS Y TÉRMICAS</span></h1>
      <p>Moldea tu figura al mejor precio con fajas, cinturillas y chalecos térmicos diseñados para maximizar tus resultados.</p>
    </div>
  </section>
{% else %}
  <section class="beauty-hero-banner" style="background-image: linear-gradient(180deg, rgba(10, 14, 26, 0.62) 0%, rgba(10, 14, 26, 0.78) 100%), url('{{ 'banner_nutricion.jpeg' | asset_url }}');">
    <div class="beauty-hero-content">
      <span class="beauty-tag-top"><svg class="inline-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg> COLECCIÓN OFICIAL 2026</span>
      <h1>REVOLUCIONA TU SALUD CON NUESTRA <span>LÍNEA DE NUTRICIÓN</span></h1>
      <p>Fórmulas naturales avanzadas diseñadas para potenciar tu energía, articulaciones y bienestar desde el primer día.</p>
    </div>
  </section>
{% endif %}

<!-- BARRA DE FILTROS -->
<section class="catalog-filters-bar">
  <div class="filters-container">
    <div class="filter-group">
      <span>Filtrar por:</span>
      <select class="filter-select" onchange="WTVCart.sortCollectionGrid(this);">
        <option value="manual">Más relevantes</option>
        <option value="price-ascending">Precio: Menor a Mayor</option>
        <option value="price-descending">Precio: Mayor a Menor</option>
      </select>
    </div>
    <div class="catalog-counter">
      <strong>{{ collection.products_count }}</strong> productos encontrados
    </div>
  </div>
</section>

<!-- GRID DE PRODUCTOS REALES DE LA COLECCIÓN EN SHOPIFY -->
<section class="bestsellers-section" style="margin-top: 20px;">
  <div class="products-grid {% if collection.products_count == 2 %}beauty-products-grid{% endif %}">
    {% for product in collection.products %}
      {% assign first_var = product.selected_or_first_available_variant %}
      {% assign prod_price_cop = first_var.price | divided_by: 100 %}
      {% assign prod_old_cop = first_var.compare_at_price | divided_by: 100 %}
      <article class="product-card beauty-card" onclick="window.location.href='{{ product.url }}'" style="cursor: pointer;">
        <div class="product-img-box">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600">
          {% else %}
            <img src="{{ 'colasteel_back.jpeg' | asset_url }}" alt="{{ product.title | escape }}" width="1856" height="2304">
          {% endif %}
        </div>
        <div class="product-rating">★★★★★ <span>(120+)</span></div>
        <h3 class="product-title">{{ product.title }}</h3>
        {% if product.type != blank %}
          <p class="product-subtitle">{{ product.type }}</p>
        {% endif %}
        <div class="product-bottom beauty-bottom">
          <div class="price-box">
            {% if product.compare_at_price > product.price %}
              <span class="old-p">{{ product.compare_at_price | money }}</span>
            {% endif %}
            <span class="new-p" style="color:var(--brand-dark);">
              {% if product.price_varies %}A partir de {% endif %}{{ product.price | money }}
            </span>
          </div>
          <button type="button" class="btn-beauty-add"
                  onclick="event.stopPropagation(); WTVCart.addItem({
                    id: '{{ product.handle }}-{{ first_var.id }}',
                    variantId: {{ first_var.id }},
                    title: {{ product.title | json | escape }},
                    packTitle: {{ first_var.title | json | escape }},
                    price: {{ prod_price_cop }},
                    oldPrice: {{ prod_old_cop | default: 0 }},
                    image: '{% if product.featured_image %}{{ product.featured_image | image_url: width: 300 }}{% else %}{{ 'colasteel_back.jpeg' | asset_url }}{% endif %}'
                  }, true);">
            AÑADIR +
          </button>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Colección Principal",
  "settings": []
}
{% endschema %}
