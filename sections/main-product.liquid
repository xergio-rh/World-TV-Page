<script>
  function selectShopifyVariant(el, variantId, priceCop, oldPriceCop, imgUrl, packTitle) {
    document.querySelectorAll('.pack-option').forEach(function(opt) {
      opt.classList.remove('active');
    });
    el.classList.add('active');

    var inputVariant = document.getElementById('selectedVariantId');
    if (inputVariant) inputVariant.value = variantId;
    var inputPackTitle = document.getElementById('selectedPackTitle');
    if (inputPackTitle) inputPackTitle.value = packTitle || '';
    var inputPackPrice = document.getElementById('selectedPackPrice');
    if (inputPackPrice) inputPackPrice.value = priceCop;
    var inputPackOld = document.getElementById('selectedPackOldPrice');
    if (inputPackOld) inputPackOld.value = oldPriceCop || 0;
    var inputPackImg = document.getElementById('selectedPackImg');
    if (inputPackImg && imgUrl) inputPackImg.value = imgUrl;

    var formattedPrice = window.WTVCart ? window.WTVCart.formatMoney(priceCop) : ('$' + Number(priceCop).toLocaleString('es-CO'));
    var formattedOld = (oldPriceCop && oldPriceCop > priceCop)
      ? (window.WTVCart ? window.WTVCart.formatMoney(oldPriceCop) : ('$' + Number(oldPriceCop).toLocaleString('es-CO')))
      : '';

    var curPriceEl = document.getElementById('dynamicCurrentPrice');
    if (curPriceEl) curPriceEl.innerHTML = formattedPrice + ' <small>COP</small>';

    var stickyPriceEl = document.getElementById('stickyDynamicPrice');
    if (stickyPriceEl) {
      stickyPriceEl.innerHTML = formattedPrice + ' <small>COP</small>' + (formattedOld ? ' <del>' + formattedOld + '</del>' : '');
    }

    var stickyPackBadge = document.getElementById('stickyPackBadge');
    if (stickyPackBadge && packTitle) {
      stickyPackBadge.textContent = '(' + packTitle + ')';
    }

    var oldPriceEl = document.getElementById('dynamicOldPrice');
    var savePillEl = document.getElementById('dynamicSavePill');
    if (oldPriceEl) {
      if (formattedOld !== '') {
        oldPriceEl.innerHTML = formattedOld;
        oldPriceEl.style.display = 'inline';
        if (savePillEl) {
          var diff = Number(oldPriceCop) - Number(priceCop);
          var diffFmt = window.WTVCart ? window.WTVCart.formatMoney(diff) : ('$' + diff.toLocaleString('es-CO'));
          savePillEl.textContent = 'Ahorra ' + diffFmt;
        }
      } else {
        oldPriceEl.style.display = 'none';
        if (savePillEl) savePillEl.textContent = 'Envío Gratis';
      }
    }

    if (imgUrl && imgUrl !== '') {
      var mainImg = document.getElementById('mainProductImg');
      if (mainImg) mainImg.src = imgUrl;
      var stickyImg = document.getElementById('stickyProductImg');
      if (stickyImg) stickyImg.src = imgUrl;
    }
  }
</script>

