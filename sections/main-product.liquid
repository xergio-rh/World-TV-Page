{% assign current_variant = product.selected_or_first_available_variant %}
{% assign prod_handle = product.handle | downcase %}

{% comment %}
  Identificación de los 9 productos de Nutrición (7) y Belleza y Bienestar (2)
  para mostrar exactamente la estructura completa de Colasteel y Melena de León.
{% endcomment %}
{% assign prod_key = 'generic' %}
{% if prod_handle contains 'cloruro' or prod_handle contains 'colasteel' %}
  {% assign prod_key = 'cloruro' %}
{% elsif prod_handle contains 'melena' %}
  {% assign prod_key = 'melena' %}
{% elsif prod_handle contains 'resveratrol' %}
  {% assign prod_key = 'resveratrol' %}
{% elsif prod_handle contains 'inositol' %}
  {% assign prod_key = 'inositol' %}
{% elsif prod_handle contains 'gamaki' or prod_handle contains 'amalaki' %}
  {% assign prod_key = 'amalaki' %}
{% elsif prod_handle contains 'colageno-marino' %}
  {% assign prod_key = 'colageno_marino' %}
{% elsif prod_handle contains 'citrato' %}
  {% assign prod_key = 'citrato' %}
{% elsif prod_handle contains 'serum' %}
  {% assign prod_key = 'serum' %}
{% elsif prod_handle contains 'cannabi' %}
  {% assign prod_key = 'cannabix' %}
{% endif %}

<!-- MAIN PRODUCT SECTION DINÁMICA PARA TODOS LOS PRODUCTOS DE SHOPIFY -->
<main class="product-main-container">
  <div class="product-grid-layout">
   
    <!-- =====================================================================
         COLUMNA IZQUIERDA: GALERÍA DE IMÁGENES DEL PRODUCTO
         (Toma automáticamente las fotos subidas al producto en Shopify Admin)
    ====================================================================== -->
    <div class="product-gallery-card">
      <div class="main-image-box">
        {% if product.featured_image %}
          <img id="mainProductImg" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title | escape }}" width="900" height="900">
        {% else %}
          <!-- [ESPACIO IMAGEN PRINCIPAL DEL PRODUCTO] -->
          <div class="img-placeholder-slot" style="height: 420px;">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <span class="slot-tag">AQUÍ IMAGEN PRINCIPAL</span>
            <span class="slot-name">{{ product.title }}</span>
          </div>
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
        <div class="thumbs-row" style="grid-template-columns: repeat({{ product.images.size | at_most: 5 }}, 1fr);">
          {% for image in product.images limit: 5 %}
            <div class="thumb-item {% if forloop.first %}active{% endif %}" onclick="changeImage(this, '{{ image | image_url: width: 900 }}')">
              <img src="{{ image | image_url: width: 240 }}" alt="{{ product.title | escape }} - Vista {{ forloop.index }}" width="240" height="240">
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- =====================================================================
         COLUMNA DERECHA: INFORMACIÓN, PAQUETES, COMPRA Y DESCRIPCIÓN EXTENDIDA
    ====================================================================== -->
    <div class="product-info-card">
      <span class="brand-tag">{{ product.vendor | default: 'WORLDTV COLOMBIA' | upcase }}</span>
      <h1 class="product-title-main">{{ product.title }}</h1>

      {% case prod_key %}
        {% when 'cloruro' %}
          <h2 class="product-subtitle-main">500 ml - Sabor a Uva</h2>
        {% when 'melena' %}
          <h2 class="product-subtitle-main">- Sabor a capuchino</h2>
        {% when 'resveratrol' %}
          <h2 class="product-subtitle-main">500 ml - Bebida Funcional Antioxidante</h2>
        {% when 'inositol' %}
          <h2 class="product-subtitle-main">Fórmula en Polvo con Biotina, Ácido Fólico y B12</h2>
        {% when 'amalaki' %}
          <h2 class="product-subtitle-main">500 ml - Extracto de Té y Colágeno</h2>
        {% when 'colageno_marino' %}
          <h2 class="product-subtitle-main">500 ml - Con Ajonjolí, Cúrcuma y Jengibre</h2>
        {% when 'citrato' %}
          <h2 class="product-subtitle-main">500 ml - Sabor Naranja con Manzanilla y Menta</h2>
        {% when 'serum' %}
          <h2 class="product-subtitle-main">Cuidado Facial con Vitamina C, Ácido Hialurónico y Vitamina E</h2>
        {% when 'cannabix' %}
          <h2 class="product-subtitle-main">Crema Tópica con CBD, Árnica, Vainilla, Colágeno y Magnesio</h2>
        {% else %}
          {% if product.type != blank %}
            <h2 class="product-subtitle-main" style="font-size: 16px; color: var(--text-muted);">{{ product.type }}</h2>
          {% endif %}
      {% endcase %}

      <div class="rating-row">
        <div class="stars">★★★★★</div>
        <span class="rating-num">4.9</span>
        <span class="reviews-count">+500 reseñas verificadas</span>
      </div>

      {% assign base_unit_price = product.variants.first.price %}
      <div class="pricing-box">
        <del class="old-price" id="dynamicOldPrice" {% unless current_variant.compare_at_price > current_variant.price %}style="display:none;"{% endunless %}>
          {{ current_variant.compare_at_price | money }}
        </del>
        <span class="current-price" id="dynamicCurrentPrice">{{ current_variant.price | money }} <small>COP</small></span>
        {% if current_variant.compare_at_price > current_variant.price %}
          {% assign savings = current_variant.compare_at_price | minus: current_variant.price %}
          <span class="save-pill" id="dynamicSavePill">Ahorra {{ savings | money }}</span>
        {% else %}
          <span class="save-pill" id="dynamicSavePill">Envío Gratis</span>
        {% endif %}
        <span class="iva-pill">IVA incluido</span>
      </div>

      <!-- SELECTOR DINÁMICO DE PAQUETES (UNA UNIDAD / PAQUETE X 2 / PAQUETE X 3) -->
      {% if product.variants.size > 1 %}
        <div class="packages-section" id="productPackagesSection"
             data-product-handle="{{ product.handle }}"
             data-product-title="{{ product.title | escape }}">
          <span class="pack-label">
            {% if product.options.first != 'Title' %}{{ product.options.first }}{% else %}Paquetes{% endif %}
          </span>
          <div class="packages-grid" style="grid-template-columns: repeat({{ product.variants.size | at_most: 4 }}, 1fr);">
            {% for variant in product.variants %}
              {% assign fallback_pack_img = product.images[forloop.index0] | default: product.featured_image %}
              {% assign var_price_cop = variant.price | divided_by: 100 %}
              {% assign calc_compare_cents = variant.compare_at_price %}
              {% if product.variants.size == 3 and forloop.index > 1 %}
                {% assign multi_regular_cents = base_unit_price | times: forloop.index %}
                {% if calc_compare_cents == blank or calc_compare_cents <= variant.price %}
                  {% assign calc_compare_cents = multi_regular_cents %}
                {% endif %}
              {% endif %}
              {% assign var_old_cop = calc_compare_cents | default: 0 | divided_by: 100 %}
              {% assign var_img_url = fallback_pack_img | image_url: width: 900 %}
              {% if variant.featured_image %}
                {% assign var_img_url = variant.featured_image | image_url: width: 900 %}
              {% endif %}
              <div class="pack-option {% if variant.id == current_variant.id %}active{% endif %}"
                   data-variant-id="{{ variant.id }}"
                   data-pack-title="{{ variant.title | escape }}"
                   data-price="{{ var_price_cop }}"
                   data-old-price="{{ var_old_cop }}"
                   data-img="{{ var_img_url }}"
                   onclick="selectShopifyVariant(this, '{{ variant.id }}', {{ var_price_cop }}, {{ var_old_cop }}, '{{ var_img_url }}', '{{ variant.title | escape }}')">
                {% if forloop.index == 2 and product.variants.size == 3 %}
                  <span class="badge-best">MÁS VENDIDO</span>
                {% endif %}
                <span class="pack-title">{{ variant.title }}</span>
                {% if product.variants.size <= 3 %}
                  {% if variant.featured_image %}
                    <img src="{{ variant.featured_image | image_url: width: 160 }}" alt="{{ variant.title | escape }}" width="160" height="160">
                  {% elsif fallback_pack_img %}
                    <img src="{{ fallback_pack_img | image_url: width: 160 }}" alt="{{ variant.title | escape }}" width="160" height="160">
                  {% endif %}
                {% endif %}
                <div class="pack-prices">
                  {% if calc_compare_cents > variant.price %}
                    <del>{{ calc_compare_cents | money }}</del>
                  {% endif %}
                  <strong>{{ variant.price | money }}</strong>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      <!-- DESCRIPCIÓN CORTA (.short-desc) SEGÚN EL PRODUCTO -->
      {% case prod_key %}
        {% when 'cloruro' %}
          <p class="short-desc">
            Este Cloruro es una bebida funcional líquida con colágeno hidrolizado, biotina, complejo B y extracto de té, diseñada para apoyar el bienestar de tus articulaciones, huesos, piel y sistema digestivo. Su presentación líquida facilita la absorción y es ideal para una rutina práctica y constante.
          </p>
        {% when 'melena' %}
          <p class="short-desc">
            Potente mezcla en polvo de Melena de León (1.500 mg), Ganoderma (700 mg) y Shiitake (3.000 mg) con complejo B y vitamina C. Delicioso sabor a capuchino, 0% azúcar añadida. Rinde 30 porciones.
          </p>
        {% when 'resveratrol' %}
          <p class="short-desc">
            Bebida funcional líquida con Resveratrol, Colágeno Hidrolizado, Biotina y Fibra Prebiótica. Elaborada con extractos naturales de uvas y ciruelas, sin azúcares añadidos, para proteger tus células del daño oxidativo, apoyar la salud cardiovascular y revitalizar tu piel y cabello.
          </p>
        {% when 'inositol' %}
          <p class="short-desc">
            Fórmula avanzada en polvo con Inositol, Ácido Fólico, Biotina y Vitamina B12. Diseñada para apoyar el equilibrio de la glucosa en sangre, el bienestar metabólico y hormonal, y reducir la sensación de cansancio y ansiedad en tu día a día.
          </p>
        {% when 'amalaki' %}
          <p class="short-desc">
            Bebida funcional líquida con extracto de Amalaki, Colágeno Hidrolizado, Biotina, Extracto de Té y Vitaminas del Complejo B. Libre de azúcares añadidos, ideal para impulsar tu energía diaria, fortalecer tus defensas antioxidantes y nutrir tu piel y cabello desde el interior.
          </p>
        {% when 'colageno_marino' %}
          <p class="short-desc">
            Bebida funcional líquida con Colágeno Marino, Cúrcuma, Ajonjolí y Jengibre. Una combinación sinérgica creada para nutrir tus articulaciones, huesos, músculos y piel mientras favorece la movilidad y el bienestar digestivo diario.
          </p>
        {% when 'citrato' %}
          <p class="short-desc">
            Fórmula líquida con Citrato de Magnesio (400 mg por porción) y extractos naturales de Manzanilla y Menta con agradable sabor a naranja. Diseñada para apoyar la relajación muscular, el descanso nocturno reparador, el sistema nervioso y tus niveles de energía.
          </p>
        {% when 'serum' %}
          <p class="short-desc">
            Sérum facial de textura ligera y rápida absorción que combina Vitamina C, Ácido Hialurónico y Vitamina E. Hidrata a profundidad, revitaliza, ayuda a unificar el tono del rostro y devuelve a tu piel una apariencia luminosa, firme y saludable.
          </p>
        {% when 'cannabix' %}
          <p class="short-desc">
            Crema de uso tópico elaborada con Cannabidiol (CBD), Árnica, Vainilla, Colágeno y Cloruro de Magnesio. Brinda alivio localizado, frescura y confort en zonas de tensión muscular y articular después de jornadas exigentes o actividad física.
          </p>
      {% endcase %}

      <!-- FORMULARIO INTERACTIVO DE CARRITO Y COMPRA (SIN LLAMADAS 401 EN DEV) -->
      {% assign init_price_cop = current_variant.price | divided_by: 100 %}
      {% assign init_old_cop = current_variant.compare_at_price | default: 0 | divided_by: 100 %}
      <div id="shopifyProductForm" class="product-buy-form-box">
        <input type="hidden" name="id" id="selectedVariantId" value="{{ current_variant.id }}">
        <input type="hidden" id="selectedProductTitle" value="{{ product.title | escape }}">
        <input type="hidden" id="selectedProductHandle" value="{{ product.handle }}">
        <input type="hidden" id="selectedPackTitle" value="{{ current_variant.title | escape }}">
        <input type="hidden" id="selectedPackPrice" value="{{ init_price_cop }}">
        <input type="hidden" id="selectedPackOldPrice" value="{{ init_old_cop }}">
        <input type="hidden" id="selectedPackImg" value="{% if product.featured_image %}{{ product.featured_image | image_url: width: 300 }}{% else %}{{ 'cloruro_x_1_IA_4a08858f-a74e-4d46-a666-cbb3b61e67df.webp' | asset_url }}{% endif %}">
        <div class="action-buttons" style="margin-top: 18px;">
          <div class="product-dual-pay-row">
            <button type="button" class="cart-checkout-btn btn-pay-now-main" style="border:none; cursor:pointer; width:100%; display:flex; align-items:center; justify-content:center; gap:7px;" onclick="WTVCart.addSelectedProductFromPage(true, 1, 'online');">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
              <span>PAGAR AHORA (TARJETA / PSE)</span>
            </button>
            <button type="button" class="cart-checkout-btn btn-cod-main" style="border:none; cursor:pointer; width:100%; display:flex; align-items:center; justify-content:center; gap:7px;" onclick="WTVCart.addSelectedProductFromPage(true, 1, 'cod');">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 18H3c-.6 0-1-.4-1-1V9c0-.6.4-1 1-1h2m14 10h2c.6 0 1-.4 1-1v-4c0-.5-.2-1-.5-1.4l-3-4c-.3-.4-.8-.6-1.3-.6H15v6m-10 4h10m-10 0a2 2 0 1 0 4 0m6 0a2 2 0 1 0 4 0M7 8h8v6H7V8z"></path></svg>
              <span>PAGO CONTRAENTREGA (SOLO DATOS)</span>
            </button>
          </div>
          <button type="button" class="btn-add-cart" style="cursor:pointer; width:100%;" onclick="WTVCart.addSelectedProductFromPage(false);">
            Agregar al carrito
          </button>
        </div>

        <!-- CAJA DESTACADA DE PAGO EN LÍNEA + CONTRAENTREGA EN FICHA DE PRODUCTO -->
        <div class="cod-product-promo-box">
          <div class="cod-promo-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          </div>
          <div class="cod-promo-text">
            <strong>TÚ ELIGES: PAGA AHORA O PAGA CONTRAENTREGA</strong>
            <span>Paga al instante con Tarjeta, PSE o Nequi, o pide con Pago Contraentrega ingresando únicamente tus datos de envío para pagar al recibir.</span>
          </div>
        </div>
      </div>

      <!-- TRUST BADGES MINI -->
      <div class="product-mini-trust">
        <div class="mini-trust-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M5 18H3c-.6 0-1-.4-1-1V9c0-.6.4-1 1-1h2m14 10h2c.6 0 1-.4 1-1v-4c0-.5-.2-1-.5-1.4l-3-4c-.3-.4-.8-.6-1.3-.6H15v6m-10 4h10m-10 0a2 2 0 1 0 4 0m6 0a2 2 0 1 0 4 0M7 8h8v6H7V8z"></path></svg>
          <div>
            <strong>ENVÍOS A COLOMBIA</strong>
            <span>Despachos rápidos y asegurados</span>
          </div>
        </div>
        <div class="mini-trust-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
          <div>
            <strong>PAGO CONTRAENTREGA</strong>
            <span>Pagas al recibir en tu puerta</span>
          </div>
        </div>
        <div class="mini-trust-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <div>
            <strong>REGISTRO INVIMA</strong>
            <span>Garantía y respaldo oficial</span>
          </div>
        </div>
        <div class="mini-trust-item">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path d="M12 22C6.5 22 2 17.5 2 12S6.5 2 12 2s10 4.5 10 10-4.5 10-10 10z"></path><path d="M12 6v6l4 2"></path></svg>
          <div>
            <strong>100% NATURALES</strong>
            <span>Ingredientes para tu bienestar</span>
          </div>
        </div>
      </div>

      <!-- ===================================================================
           DESCRIPCIÓN EXTENDIDA ESTRUCTURADA (.product-extended-details)
           Idéntica en diseño a Colasteel y Melena de León para los 9 productos
      ==================================================================== -->
      <div class="product-extended-details">
        {% case prod_key %}
          {% when 'cloruro' %}
            <p class="lead-text">Bebida funcional de Cloruro de Magnesio enriquecida con Colágeno, Biotina, Complejo B y Extracto de Té.</p>
            <ul class="benefits-bullet-list">
              <li>Delicioso sabor a Uva, perfecto para disfrutar frío en cualquier momento del día.</li>
              <li>Presentación líquida de rápida absorción, ideal para asimilar sus nutrientes de forma más eficiente.</li>
              <li>Sin complicaciones: tómalo directo o diluido en tu bebida favorita como parte de tu rutina diaria.</li>
              <li>Contenido rinde para 33 porciones aproximadamente (envase de 500 ml).</li>
            </ul>
            <h3>¿Qué lo hace diferente?</h3>
            <ul class="benefits-bullet-list">
              <li><strong>Fórmula Multibeneficio Completa:</strong> Combina Cloruro de Magnesio + Colágeno + Biotina en un solo producto.</li>
              <li><strong>Soporte para Articulaciones y Huesos:</strong> Formulado para apoyar la movilidad, flexibilidad y reducir la rigidez.</li>
              <li><strong>Nutrición para Piel, Cabello y Uñas:</strong> Fortalece los tejidos desde el interior con péptidos de colágeno y biotina.</li>
              <li><strong>Bienestar Digestivo y Vitalidad:</strong> El Complejo B junto al extracto de té favorecen la digestión y la energía diaria.</li>
              <li><strong>Registro INVIMA y Calidad Garantizada:</strong> Producido en Colombia bajo estrictos estándares GMP.</li>
            </ul>

          {% when 'melena' %}
            <p class="lead-text">Descubre la fuerza de los hongos funcionales y adaptógenos en tu rutina diaria.</p>
            <ul class="benefits-bullet-list">
              <li>Exquisito sabor a Capuchino, ideal para preparar en agua tibia o fría todas las mañanas.</li>
              <li>Triple sinergia de hongos funcionales: Melena de León (1.500 mg), Ganoderma (700 mg) y Shiitake (3.000 mg).</li>
              <li>Fórmula limpia con 0% azúcar añadida, fortificada con Complejo B y Vitamina C.</li>
              <li>Contenido neto que rinde 30 porciones completas por envase (cuchara medidora de 15 g).</li>
            </ul>
            <h3>¿Qué lo hace diferente?</h3>
            <ul class="benefits-bullet-list">
              <li><strong>Enfoque, Memoria y Claridad Mental:</strong> Estimula el factor de crecimiento nervioso (NGF) para cuidar tu salud cognitiva.</li>
              <li><strong>Alta Concentración por Porción:</strong> Aporta 5.200 mg combinados de hongos funcionales puros en cada toma.</li>
              <li><strong>Energía Sostenida sin Nerviosismo:</strong> Las vitaminas B1, B2, B3, B6 y B12 optimizan tu vitalidad celular.</li>
              <li><strong>Soporte Inmunológico y Digestivo:</strong> El Ganoderma y el Shiitake fortalecen tus defensas naturales y microbiota.</li>
              <li><strong>Calidad Certificada World TV:</strong> Elaborado bajo rigurosos estándares de Buenas Prácticas de Manufactura (GMP).</li>
            </ul>

          {% when 'resveratrol' %}
            <p class="lead-text">Bebida funcional antioxidante con Resveratrol, Colágeno Hidrolizado, Biotina y Fibra Prebiótica.</p>
            <ul class="benefits-bullet-list">
              <li>Fórmula líquida inspirada en los polifenoles naturales de las uvas y ciruelas, libre de azúcares añadidos.</li>
              <li>Asimilación rápida que protege las células frente al envejecimiento prematuro y los radicales libres.</li>
              <li>Fácil de integrar en tu mañana o noche: sírvelo directo o mezclado en un vaso de agua.</li>
              <li>Envase de 500 ml con rendimiento aproximado para 33 porciones diarias.</li>
            </ul>
            <h3>¿Qué lo hace diferente?</h3>
            <ul class="benefits-bullet-list">
              <li><strong>Acción Antioxidante Avanzada:</strong> El Resveratrol protege las células del daño oxidativo y promueve la longevidad celular.</li>
              <li><strong>Cuidado Cardiovascular y Circulatorio:</strong> Apoya la salud del corazón y el flujo sanguíneo saludable.</li>
              <li><strong>Sinergia Antiedad con Colágeno y Biotina:</strong> Favorece la firmeza de la piel, atenúa líneas de expresión y fortalece el cabello.</li>
              <li><strong>Equilibrio Digestivo con Fibra Prebiótica:</strong> Mejora la salud intestinal para una óptima absorción de cada nutriente.</li>
              <li><strong>Fórmula Limpia sin Azúcar Añadida:</strong> Ideal para cuidar tu bienestar metabólico todos los días.</li>
            </ul>

          {% when 'inositol' %}
            <p class="lead-text">Suplemento nutricional en polvo con Inositol, Biotina, Ácido Fólico (Vitamina B9) y Vitamina B12.</p>
            <ul class="benefits-bullet-list">
              <li>Polvo de fácil disolución para preparar rápidamente en un vaso de agua una vez al día.</li>
              <li>Diseñado para apoyar la respuesta natural a la insulina y evitar picos de glucosa después de las comidas.</li>
              <li>Contribuye al equilibrio hormonal, metabólico y del sistema nervioso central.</li>
              <li>Excelente rendimiento diario para acompañar tu estilo de vida saludable.</li>
            </ul>
            <h3>¿Qué lo hace diferente?</h3>
            <ul class="benefits-bullet-list">
              <li><strong>Control Metabólico y de Glucosa:</strong> Ayuda a mejorar la sensibilidad a la insulina y el aprovechamiento energético.</li>
              <li><strong>Apoyo al Equilibrio Hormonal:</strong> Especialmente valorado para el bienestar integral femenino y metabólico.</li>
              <li><strong>Reducción de Ansiedad y Fatiga:</strong> El Inositol junto a la Vitamina B12 favorecen la calma mental y combaten el cansancio.</li>
              <li><strong>Belleza Capilar y Cutánea:</strong> La combinación de Biotina y Ácido Fólico nutre el folículo piloso, la piel y las uñas.</li>
              <li><strong>Pureza y Respaldo Oficial:</strong> Fórmula desarrollada con materias primas seleccionadas bajo estándares GMP.</li>
            </ul>

          {% when 'amalaki' %}
            <p class="lead-text">Bebida funcional revitalizante con Extracto de Amalaki, Colágeno Hidrolizado, Biotina, Extracto de Té y Complejo B.</p>
            <ul class="benefits-bullet-list">
