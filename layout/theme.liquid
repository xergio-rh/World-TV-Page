<!DOCTYPE html>
<html lang="{{ request.locale.iso_code | default: 'es' }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; etiquetado "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Tipografías Oficiales World TV (Arsenal para Títulos + Assistant para Textos y UI) -->
  {% # theme-check-disable RemoteAsset %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Arsenal:ital,wght@0,400;0,700;1,400;1,700&family=Assistant:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  {% # theme-check-enable RemoteAsset %}

  <!-- Hojas de estilo completas para navegación fluida sin 404 -->
  {{ 'nutricion.css' | asset_url | stylesheet_tag }}
  {{ 'vision.css' | asset_url | stylesheet_tag }}
  {{ 'belleza.css' | asset_url | stylesheet_tag }}
  {{ 'outlet.css' | asset_url | stylesheet_tag }}
  {{ 'producto.css' | asset_url | stylesheet_tag }}
  {{ 'styles.css' | asset_url | stylesheet_tag }}
  {{ 'animations.css' | asset_url | stylesheet_tag }}

  <style>
    @font-face {
      font-family: 'Assistant';
      font-weight: 400;
      font-style: normal;
      font-display: swap;
      src: url("https://www.worldtv.com.co/cdn/fonts/assistant/assistant_n4.9120912a469cad1cc292572851508ca49d12e768.woff2") format("woff2"),
           url("https://www.worldtv.com.co/cdn/fonts/assistant/assistant_n4.6e9875ce64e0fefcd3f4446b7ec9036b3ddd2985.woff") format("woff");
    }
    @font-face {
      font-family: 'Assistant';
      font-weight: 700;
      font-style: normal;
      font-display: swap;
      src: url("https://www.worldtv.com.co/cdn/fonts/assistant/assistant_n7.bf44452348ec8b8efa3aa3068825305886b1c83c.woff2") format("woff2"),
           url("https://www.worldtv.com.co/cdn/fonts/assistant/assistant_n7.0c887fee83f6b3bda822f1150b912c72da0f7b64.woff") format("woff");
    }
    @font-face {
      font-family: 'Arsenal';
      font-weight: 400;
      font-style: normal;
      font-display: swap;
      src: url("https://www.worldtv.com.co/cdn/fonts/arsenal/arsenal_n4.51305299cd12b61bc0400367405b80442269043d.woff2") format("woff2"),
           url("https://www.worldtv.com.co/cdn/fonts/arsenal/arsenal_n4.93261dd112afca16489c9f1c0d423ccd8a12c0a3.woff") format("woff");
    }
    :root {
      --font-serif: 'Arsenal', sans-serif !important;
      --font-sans: 'Assistant', sans-serif !important;
      --font-heading-family: 'Arsenal', sans-serif !important;
      --font-body-family: 'Assistant', sans-serif !important;
      --brand-red: {{ settings.brand_red | default: '#D90429' }};
      --brand-burgundy: {{ settings.brand_burgundy | default: '#9E2A2B' }};
      --brand-dark: {{ settings.brand_dark | default: '#1A1A1A' }};
      --bg-cream: {{ settings.bg_cream | default: '#F7F5F0' }};
    }
    body, button, input, select, textarea {
      font-family: 'Assistant', sans-serif !important;
      letter-spacing: 0.025rem;
    }
    h1, h2, h3, .hero-title, .vision-title, .outlet-title, .product-title-main, .section-header h2, .section-title-center {
      font-family: 'Arsenal', sans-serif !important;
      letter-spacing: 0.02rem;
    }
    img {
      max-width: 100%;
      height: auto;
    }
    .product-img-box,
    .beauty-card .product-img-box {
      height: 240px !important;
      padding: 10px !important;
      background-color: #FFFFFF !important;
      border-radius: 10px !important;
      overflow: hidden !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
    .product-img-box img,
    .beauty-card .product-img-box img,
    .main-image-box img,
    .thumb-item img,
    .kit-image-box img,
    .ingredient-circle img,
    .usage-img img,
    .model-img-thumb img {
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      object-fit: contain !important;
      object-position: center !important;
    }
    .vision-image-card img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: center 20% !important;
    }
    .pack-option img,
    .chk-pkg-card img,
    .upsell-card img {
      width: auto !important;
      max-width: 100% !important;
      object-fit: contain !important;
      margin-left: auto;
      margin-right: auto;
      display: block;
    }
    .wtv-spa-view {
      display: none;
      animation: wtvPageFadeIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .wtv-spa-view.active {
      display: block;
    }
  </style>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name | handle }}">

  {% section 'header' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  <!-- CONTENEDOR DE VISTAS INSTANTÁNEAS (EVITA 404 AUN SIN CREAR COLECCIONES EN SHOPIFY) -->
  <div id="wtvDynamicViews">
    <div id="wtv-view-nutricion" class="wtv-spa-view">{% render 'view-nutricion' %}</div>
    <div id="wtv-view-vision" class="wtv-spa-view">{% render 'view-vision' %}</div>
    <div id="wtv-view-belleza" class="wtv-spa-view">{% render 'view-belleza' %}</div>
    <div id="wtv-view-outlet" class="wtv-spa-view">{% render 'view-outlet' %}</div>
    <div id="wtv-view-colasteel" class="wtv-spa-view">{% render 'view-producto-colasteel' %}</div>
    <div id="wtv-view-melena" class="wtv-spa-view">{% render 'view-producto-melena' %}</div>
  </div>

  {% section 'footer' %}

  {% render 'cart-and-checkout' %}

  <script>
    window.navigateToWorldTV = function(viewKey, fallbackUrl) {
      var mainContent = document.getElementById('MainContent');
      var viewsContainer = document.getElementById('wtvDynamicViews');
      var allViews = document.querySelectorAll('.wtv-spa-view');
      var navLinks = document.querySelectorAll('#navLinks a[data-wtv-nav]');

      // Cerrar menú móvil si está abierto
      var navList = document.getElementById('navLinks');
      if (navList) {
        navList.classList.remove('show-mobile');
        navList.classList.remove('active');
      }

      // Actualizar estado activo del menú
      navLinks.forEach(function(link) {
        if (link.getAttribute('data-wtv-nav') === viewKey) {
          link.style.color = 'var(--brand-red)';
          link.style.fontWeight = '700';
        } else {
          link.style.color = '';
          link.style.fontWeight = '';
        }
      });

      if (viewKey === 'home') {
        allViews.forEach(function(v) { v.classList.remove('active'); });
        if (mainContent) {
          mainContent.style.display = 'block';
          mainContent.querySelectorAll('.reveal-item').forEach(function(el) {
            el.classList.add('revealed');
          });
        }
        // Si estamos atrapados en una ruta /404 o fuera de inicio, volver a la raíz
        if (window.location.pathname !== '/' && window.location.pathname !== '{{ routes.root_url }}') {
          window.location.href = '{{ routes.root_url }}';
          return;
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
        return;
      }

      var targetEl = document.getElementById('wtv-view-' + viewKey);
      if (targetEl && mainContent) {
        mainContent.style.display = 'none';
        allViews.forEach(function(v) { v.classList.remove('active'); });
        targetEl.classList.add('active');
        // Revelar elementos animados dentro de la vista activa
        targetEl.querySelectorAll('.reveal-item').forEach(function(el) {
          el.classList.add('revealed');
        });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else if (fallbackUrl) {
        window.location.href = fallbackUrl;
      }
    };

    // Si la URL tiene un hash (#nutricion, #vision, #belleza, #outlet, #melena, #colasteel), activarlo al cargar
    document.addEventListener('DOMContentLoaded', function() {
      var hash = (window.location.hash || '').replace('#', '').toLowerCase();
      if (['nutricion', 'vision', 'belleza', 'outlet', 'melena', 'colasteel'].indexOf(hash) !== -1) {
        window.navigateToWorldTV(hash);
      }
    });
  </script>

  <script src="{{ 'scripts.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'producto.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>

  <!-- BOTÓN FLOTANTE OFICIAL DE WHATSAPP CONVERSACIONAL (MÓVIL & ESCRITORIO) -->
  <a href="https://wa.me/573009121876?text=Hola%20World%20TV,%20quiero%20informaci%C3%B3n%20sobre%20un%20producto%20y%20el%20pago%20contraentrega"
     class="wtv-whatsapp-float"
     target="_blank"
     rel="noopener noreferrer"
     aria-label="Chatear por WhatsApp">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.19 8.19 0 0 1 2.41 5.82c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.85-.38-4.08-1.1l-.29-.17-3.04.8 1.05-2.95-.19-.31a8.19 8.19 0 0 1-1.25-4.33c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.25-1.48-1.39-1.73-.14-.25-.01-.39.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.17-.47-.29z"/>
    </svg>
    <span class="wtv-wa-tooltip">¿Dudas? Escríbenos</span>
  </a>

</body>
</html>
